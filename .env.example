# CoursePlan 服务端环境变量示例
# 用法：cp .env.example .env 然后填写。切勿把填好的 .env 提交到版本库。

# JWT 签名密钥（必填）。
# 服务端启动时若缺失会直接失败；请使用足够随机的值，生成方式：
#   openssl rand -hex 32
JWT_SECRET=

# TLS 叠加（docker-compose.tls.yml）使用：你的公网域名。
# 需已解析到本机并放通 80/443，Caddy 会自动申请证书。
COURSEPLAN_DOMAIN=

# 日志级别（默认 info）：error | warn | info | debug | trace
RUST_LOG=info
